<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:layout_margin="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_gallery"
                android:scaleType="centerCrop" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/lightButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/light"
                    android:background="@drawable/circle"
                    android:backgroundTint="#80808080"
                    android:scaleType="fitCenter"
                    android:padding="13dp"
                    android:tint="@color/white" />

                <ImageButton
                    android:id="@+id/closeButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/close"
                    android:background="@drawable/circle"
                    android:backgroundTint="#80808080"
                    android:scaleType="fitCenter"
                    android:padding="13dp"
                    android:tint="@color/white"
                    android:layout_alignParentEnd="true" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_alignParentBottom="true">

                <ImageView
                    android:id="@+id/picture"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/default_gallery"
                    android:layout_marginHorizontal="5dp"
                    android:padding="2dp"
                    android:layout_centerVertical="true"
                    android:background="@color/white" />

                <ImageButton
                    android:id="@+id/flashButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="20dp"
                    android:src="@drawable/flash"
                    android:layout_centerVertical="true"
                    android:background="@drawable/circle"
                    android:backgroundTint="#80808080"
                    android:scaleType="fitCenter"
                    android:padding="13dp"
                    android:tint="@color/white"
                    android:layout_toEndOf="@id/picture" />

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_centerInParent="true"
                    android:background="@drawable/circle"
                    android:backgroundTint="#dad5b8">

                    <View
                        android:id="@+id/capture"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_margin="10dp"
                        android:background="@drawable/circle"
                        android:backgroundTint="@color/white" />

                </LinearLayout>

                <ImageButton
                    android:id="@+id/captureButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="20dp"
                    android:src="@drawable/arrowcircle"
                    android:background="@drawable/circle"
                    android:backgroundTint="#80808080"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:padding="13dp"
                    android:tint="@color/white"
                    android:layout_toStartOf="@id/faceButton" />

                <ImageButton
                    android:id="@+id/faceButton"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="5dp"
                    android:src="@drawable/face"
                    android:background="@drawable/circle"
                    android:backgroundTint="#80808080"
                    android:layout_centerVertical="true"
                    android:scaleType="fitCenter"
                    android:padding="13dp"
                    android:tint="@color/white"
                    android:layout_alignParentEnd="true" />

                <View
                    android:id="@+id/faceNotification"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/red"
                    android:layout_alignParentEnd="true"
                    android:translationY="27dp"
                    android:translationX="-10dp" />

            </RelativeLayout>

        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:orientation="horizontal"
            android:background="@color/black">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TEXT"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="5dp"
                    android:visibility="gone"
                    android:background="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="5dp"
                    android:visibility="gone"
                    android:background="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="STORY"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="1">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="POST"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="5dp"
                    android:visibility="gone"
                    android:background="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_weight="2">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BOOMERANG"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginBottom="5dp"
                    android:gravity="center"
                    android:textSize="16sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginHorizontal="5dp"
                    android:visibility="gone"
                    android:background="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>