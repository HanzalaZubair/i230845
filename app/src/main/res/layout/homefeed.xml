<?xml version="1.0" encoding="UTF-8" ?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:text="Kinnect"
            android:textColor="#0B5F63"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center_vertical" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/search"
                android:background="@drawable/circle"
                android:backgroundTint="#dad5b8"
                android:layout_marginRight="10dp"
                android:scaleType="fitCenter"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/messenger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/messenger"
                android:background="@drawable/circle"
                android:backgroundTint="#dad5b8"
                android:scaleType="fitCenter"
                android:padding="10dp" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="3"
                android:textColor="@color/white"
                android:background="@drawable/circle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:backgroundTint="@color/red"
                android:translationX="-15dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/home"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/home"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/friends"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/friends"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="2"
                android:textColor="@color/white"
                android:background="@drawable/circle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:backgroundTint="@color/red"
                android:translationX="-15dp"
                android:translationY="-10dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/marketplace"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/market"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="1"
                android:textColor="@color/white"
                android:background="@drawable/circle"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:backgroundTint="@color/red"
                android:translationX="-15dp"
                android:translationY="-10dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/notification"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_weight="1"
                android:src="@drawable/notification"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter" />

            <TextView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:text="5"
                android:textColor="@color/white"
                android:background="@drawable/circle"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:backgroundTint="@color/red"
                android:translationX="-30dp"
                android:translationY="-10dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/menu"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/menu"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:padding="5dp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_marginBottom="5dp"
        android:paddingHorizontal="10dp">

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:background="@drawable/circle"
                android:backgroundTint="#0B5F63"
                android:gravity="center"
                android:text="JW"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <EditText
            android:id="@+id/createPost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="4"
            android:hint="What's on your mind, Jacob?"
            android:background="@drawable/border"
            android:textSize="16sp"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center">

            <ImageButton
                android:id="@+id/photoPicker"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/photo"
                android:tint="#0B5F63"
                android:padding="10dp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:background="@color/gray"
        android:layout_marginBottom="5dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:background="#80808080"
            android:padding="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:background="@color/gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Create Story"
                android:textColor="@color/black"
                android:background="@color/white"
                android:gravity="center"
                android:textSize="16dp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true" />

            <TextView
                android:id="@+id/yourStory"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:background="@drawable/circle"
                android:backgroundTint="#0B5F63"
                android:gravity="center"
                android:text="JW"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_centerHorizontal="true"
                android:layout_marginVertical="12dp" />

            <TextView
                android:id="@+id/addStory"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:background="@drawable/circle"
                android:backgroundTint="#0B5F63"
                android:text="+"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_centerHorizontal="true"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:translationY="-30dp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/omarStory"
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:background="#80808080"
            android:padding="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gray"
                android:src="@drawable/default_gallery"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Omar Farooq"
                android:textColor="@color/white"
                android:background="@android:color/black"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:alpha="0.6"
                android:elevation="5dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle"
                android:backgroundTint="#2daa02"
                android:gravity="center"
                android:text="OF"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_margin="10dp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="120dp"
            android:layout_height="match_parent"
            android:background="#80808080"
            android:padding="5dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/gray"
                android:src="@drawable/default_gallery"
                android:scaleType="centerCrop" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Sara Iqbal"
                android:textColor="@color/white"
                android:background="@android:color/black"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_alignParentBottom="true"
                android:alpha="0.6"
                android:elevation="5dp" />

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circle"
                android:backgroundTint="@color/purple"
                android:gravity="center"
                android:text="SI"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_margin="10dp"
                android:elevation="5dp" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="7"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/circle"
                android:backgroundTint="#2daa02"
                android:gravity="center"
                android:text="LM"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_margin="10dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="5"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Lina Marsh is at Clifton Beach"
                    android:gravity="center_vertical"
                    android:textColor="@color/black"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="2h -"
                    android:drawableEnd="@drawable/globe"
                    android:gravity="center_vertical"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/meatballs_menu"
                android:scaleType="fitCenter"
                android:padding="10dp" />

            <ImageButton
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:src="@drawable/close"
                android:scaleType="fitCenter"
                android:padding="10dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/postCaption"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.3"
            android:text="Sunset walk with the crew. Worth every grain of sand in my shoes"
            android:textColor="@color/black"
            android:textSize="16dp"
            android:padding="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="4"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:src="@drawable/default_gallery"
                android:scaleType="centerCrop"
                android:layout_margin="5dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="5dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:src="@drawable/default_gallery"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="5dp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/default_gallery"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="+4"
                        android:textColor="@color/white"
                        android:textSize="26sp"
                        android:background="@color/black"
                        android:alpha="0.7"
                        android:gravity="center"
                        android:textStyle="bold" />

                </RelativeLayout>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.7"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:layout_marginLeft="10dp">

                <ImageView
                    android:id="@+id/like"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/like"
                    android:tint="@color/white"
                    android:background="@drawable/circle"
                    android:backgroundTint="#0B5F63"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    android:foregroundGravity="center_vertical" />

                <ImageView
                    android:id="@+id/heart"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/heart"
                    android:tint="@color/white"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/red"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    android:foregroundGravity="center_vertical"
                    android:layout_toEndOf="@id/like"
                    android:translationX="-10dp" />

                <ImageView
                    android:id="@+id/emoji"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/emoji"
                    android:tint="@color/white"
                    android:background="@drawable/circle"
                    android:backgroundTint="@color/orange"
                    android:scaleType="fitCenter"
                    android:padding="5dp"
                    android:foregroundGravity="center_vertical"
                    android:layout_toEndOf="@id/heart"
                    android:translationX="-20dp" />

            </RelativeLayout>

            <TextView
                android:id="@+id/comments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="Aisha and 1.2k likes - 86 comments - 12 shares"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:layout_weight="4" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Like"
                android:drawableStart="@drawable/like"
                android:drawablePadding="10dp"
                android:textSize="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:paddingHorizontal="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Comment"
                android:drawableStart="@drawable/comment"
                android:drawablePadding="10dp"
                android:textSize="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:paddingHorizontal="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Share"
                android:drawableStart="@drawable/share"
                android:drawablePadding="10dp"
                android:textSize="18dp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:layout_gravity="center_vertical"
                android:paddingHorizontal="20dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>