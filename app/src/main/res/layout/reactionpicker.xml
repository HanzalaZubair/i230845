<?xml version="1.0" encoding="utf-8" ?>

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="10dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <ImageButton
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/left_arrow"
            android:background="@android:color/transparent"
            android:scaleType="fitCenter"
            android:padding="7dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:text="Lina's Post"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:textColor="@color/black" />

    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8">

        <LinearLayout
            android:id="@+id/postContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/circle"
                    android:backgroundTint="#2daa02"
                    android:gravity="center"
                    android:text="LM"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_margin="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="Lina Marsh is at Clifton Beach"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="2h -"
                        android:drawableEnd="@drawable/globe"
                        android:gravity="center_vertical"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/meatballs_menu"
                    android:scaleType="fitCenter"
                    android:padding="10dp" />

                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/close"
                    android:scaleType="fitCenter"
                    android:padding="10dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Sunset walk with the crew. Worth every grain of sand in my shoes"
                android:textColor="@color/black"
                android:textSize="16dp"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="4"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:src="@drawable/default_gallery"
                    android:scaleType="centerCrop"
                    android:layout_margin="5dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.7"
                android:orientation="horizontal"
                >

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="20dp">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/like"
                        android:tint="@color/white"
                        android:background="@drawable/circle"
                        android:backgroundTint="#0B5F63"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:foregroundGravity="center_vertical"
                        android:id="@+id/like" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/heart"
                        android:tint="@color/white"
                        android:background="@drawable/circle"
                        android:backgroundTint="@color/red"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:foregroundGravity="center_vertical"
                        android:id="@+id/heart"
                        android:layout_toEndOf="@+id/like"
                        android:translationX="-10dp" />

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/emoji"
                        android:tint="@color/white"
                        android:background="@drawable/circle"
                        android:backgroundTint="@color/orange"
                        android:scaleType="fitCenter"
                        android:padding="5dp"
                        android:foregroundGravity="center_vertical"
                        android:id="@+id/emoji"
                        android:layout_toEndOf="@+id/heart"
                        android:translationX="-20dp" />

                </RelativeLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Aisha and 1.2k likes - 86 comments - 12 shares"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:gravity="center_vertical"
                    android:layout_weight="4" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionRow"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/likeButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Like"
                    android:drawableStart="@drawable/like"
                    android:drawablePadding="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:paddingHorizontal="20dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Comment"
                    android:drawableStart="@drawable/comment"
                    android:drawablePadding="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Share"
                    android:drawableStart="@drawable/share"
                    android:drawablePadding="10dp"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:paddingHorizontal="20dp" />

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/reactionPicker"
            android:layout_width="wrap_content"
            android:layout_height="55dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="25dp"
            android:layout_marginBottom="55dp"
            android:background="#E5E5E5"
            android:padding="5dp"
            android:elevation="10dp"
            android:visibility="gone"
            >

            <ImageView
                android:id="@+id/reactionLike"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/like"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="#0B5F63"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:layout_centerVertical="true" />

            <ImageView
                android:id="@+id/reactionHeart"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/heart"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="@color/red"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/reactionLike"
                android:layout_marginStart="5dp" />

            <ImageView
                android:id="@+id/reactionEmoji"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/emoji"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="@color/orange"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/reactionHeart"
                android:layout_marginStart="5dp" />

            <ImageView
                android:id="@+id/reactionFour"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/emoji"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="#F4C430"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/reactionEmoji"
                android:layout_marginStart="5dp" />

            <ImageView
                android:id="@+id/reactionFive"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:src="@drawable/emoji"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="#8E44AD"
                android:scaleType="fitCenter"
                android:padding="7dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/reactionFour"
                android:layout_marginStart="5dp" />

        </RelativeLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="Most relevant"
            android:gravity="center_vertical"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:drawableEnd="@drawable/down"
            android:drawablePadding="5dp"
            android:layout_marginStart="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="5dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/circle"
                android:backgroundTint="@color/brown"
                android:gravity="center"
                android:text="AK"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#80808080"
                android:layout_marginLeft="10dp"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aisha Khan"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The sky is unreal."
                    android:textColor="@color/black"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>