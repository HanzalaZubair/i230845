<?xml version="1.0" encoding="UTF-8" ?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="@color/black"
    android:orientation="vertical"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical"
        android:layout_margin="10dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="9"
            >

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/default_gallery"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:orientation="horizontal"
                android:layout_margin="5dp"
                android:id="@+id/statusline"
                >
                <View
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="4dp"
                    android:layout_margin="3dp"
                    android:background="@color/white"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_below="@+id/statusline"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/name"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/circle"
                    android:backgroundTint="#0B5F63"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:text="JW"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_margin="10dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="5"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="Your story"
                        android:gravity="center_vertical"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:text="11h - Closee friends"
                        android:textColor="@color/white"
                        android:gravity="center_vertical"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        />

                </LinearLayout>

                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/close"
                    android:tint="@color/white"
                    android:scaleType="fitCenter"
                    android:padding="10dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saturday plans"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="24sp"
                android:background="@color/brown"
                android:padding="10dp"
                android:layout_marginTop="350dp"
                android:layout_marginLeft="50dp"/>

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/heart"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="@color/red"
                android:scaleType="fitCenter"
                android:padding="5dp"
                android:foregroundGravity="center_vertical"
                android:id="@+id/heart"
                android:layout_alignParentBottom="true"
                android:translationY="-150dp"
                android:translationX="30dp"
                />
            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/heart"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="@color/red"
                android:scaleType="fitCenter"
                android:padding="5dp"
                android:foregroundGravity="center_vertical"
                android:id="@+id/heart"
                android:layout_alignParentBottom="true"
                android:translationY="-100dp"
                android:translationX="10dp"
                />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/heart"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="@color/red"
                android:scaleType="fitCenter"
                android:padding="5dp"
                android:foregroundGravity="center_vertical"
                android:id="@+id/heart"
                android:layout_alignParentBottom="true"
                android:translationY="-70dp"
                android:translationX="30dp"
                />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@drawable/heart"
                android:tint="@color/white"
                android:background="@drawable/circle"
                android:backgroundTint="@color/red"
                android:scaleType="fitCenter"
                android:padding="5dp"
                android:foregroundGravity="center_vertical"
                android:id="@+id/heart"
                android:layout_alignParentBottom="true"
                android:translationY="-40dp"
                android:translationX="10dp"
                />


        </RelativeLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.5"
            android:orientation="horizontal"
            android:background="@color/black" >

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="2"
                >

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:layout_marginLeft="10dp"
                    >

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/circle"
                        android:text="AK"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/brown"
                        android:gravity="center"
                        android:id="@+id/like"
                        />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/circle"
                        android:backgroundTint="@color/purple"
                        android:text="LM"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/heart"
                        android:layout_toEndOf="@+id/like"
                        android:translationX="-10dp"
                        />

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:background="@drawable/circle"
                        android:backgroundTint="#0B5F63"
                        android:text="OF"
                        android:textColor="@color/white"
                        android:id="@+id/emoji"
                        android:layout_toEndOf="@+id/heart"
                        android:gravity="center"
                        android:translationX="-20dp"
                        />


                </RelativeLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Seen by 24"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginTop="-5dp"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                >

                <ImageButton
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/highlight"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/white"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Highlight"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginTop="-5dp"
                    />

            </LinearLayout>


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                >

                <ImageButton
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/send"
                    android:padding="3dp"
                    android:scaleType="fitCenter"
                    android:tint="@color/white"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="Send"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginTop="-5dp"
                    />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                >

                <ImageButton
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:src="@drawable/meatballs_menu"
                    android:scaleType="fitCenter"
                    android:tint="@color/white"
                    />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:text="More"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:layout_marginTop="-5dp"
                    />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
